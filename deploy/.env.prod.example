# Production settings for docker-compose.prod.yml. Copy to deploy/.env (never commit it).

# Public hostname pointing at this server (free option: a DuckDNS subdomain).
SWARM_DOMAIN=example.duckdns.org

# Database password: letters and digits only (it is embedded in a URL). Example:
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me-0123456789abcdef

# Dashboard login. Generate both on any machine with the backend installed:
#   cd backend && uv run swarm hash-password
#   cd backend && uv run swarm gen-secret
SWARM_AUTH_PASSWORD_HASH=scrypt:16384:8:1:REPLACE:REPLACE
SWARM_SECRET_KEY=replace-with-the-output-of-swarm-gen-secret-0123456789
SWARM_TOKEN_TTL_HOURS=168

# Live signals (optional). Test credentials first: docker run ... swarm feed-check
SWARM_LIVE_AUTOSTART=false
SWARM_LIVE_HISTORY_SOURCE=dukascopy
SWARM_LIVE_FEED=capital
# Capital.com demo: API key + login e-mail + the key's custom password (2FA required for keys).
# SWARM_CAPITAL_API_KEY=
# SWARM_CAPITAL_IDENTIFIER=
# SWARM_CAPITAL_PASSWORD=
# Or OANDA practice (v20 accounts only): SWARM_LIVE_FEED=oanda and
# SWARM_OANDA_TOKEN=

# Alerts for active champions (optional).
# SWARM_NOTIFY_WEBHOOK_URL=
# SWARM_TELEGRAM_BOT_TOKEN=
# SWARM_TELEGRAM_CHAT_ID=
