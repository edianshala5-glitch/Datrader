# Copy to backend/.env. All settings use the SWARM_ prefix (see app/core/config.py).
SWARM_ENVIRONMENT=dev
SWARM_LOG_LEVEL=INFO
SWARM_DATA_DIR=./data

# Zero-setup default: SQLite file. For Postgres (docker compose up postgres):
# SWARM_DATABASE_URL=postgresql+asyncpg://swarm:swarm@localhost:5432/swarm
SWARM_DATABASE_URL=sqlite+aiosqlite:///./data/swarm.db

# Leave unset for the in-process event bus. Set to share events across worker processes:
# SWARM_REDIS_URL=redis://localhost:6379/0

# Live prices from a free Capital.com demo account (the default live feed).
# API key: Capital.com > Settings > API integrations > Generate new key (2FA must be on).
# Give the key a custom password and use that below. Keys can trade; this system never does.
# SWARM_LIVE_FEED=capital
# SWARM_CAPITAL_API_KEY=
# SWARM_CAPITAL_IDENTIFIER=you@example.com
# SWARM_CAPITAL_PASSWORD=

# Alternative live feed: OANDA v20 practice account (free demo; v20 accounts only). Token from the OANDA hub (Manage API Access).
# SWARM_OANDA_TOKEN=...
# SWARM_OANDA_ACCOUNT_ID=...   (optional, discovered automatically)
# Alerts for active champions (optional):
# SWARM_NOTIFY_WEBHOOK_URL=https://discord.com/api/webhooks/...
# SWARM_TELEGRAM_BOT_TOKEN=...
# SWARM_TELEGRAM_CHAT_ID=...

# Dashboard login (required when SWARM_ENVIRONMENT=prod). Generate with:
#   uv run swarm hash-password     and     uv run swarm gen-secret
# SWARM_AUTH_PASSWORD_HASH=scrypt:...
# SWARM_SECRET_KEY=...
# Start the OANDA live engine together with the API (auto-restarts after crashes):
# SWARM_LIVE_AUTOSTART=true
